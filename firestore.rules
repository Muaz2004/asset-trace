rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isStaffActive() {
      return isSignedIn() && staffDoc() != null && staffDoc().data.active == true;
    }

    function getStaffRole() {
      return staffDoc().data.role;
    }

    function isAdmin() {
      return isStaffActive() && getStaffRole() == 'admin';
    }

    function isRegistrationOfficer() {
      return isStaffActive() && (getStaffRole() == 'registration_officer' || getStaffRole() == 'admin');
    }

    function canVerify() {
      return isStaffActive() && (
        getStaffRole() == 'admin' ||
        getStaffRole() == 'security_officer' ||
        getStaffRole() == 'library_staff' ||
        getStaffRole() == 'registration_officer'
      );
    }

    // --- Staff Profiles ---
    match /staff/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // --- Computer Registrations ---
    match /registrations/{registrationId} {
      allow read: if canVerify();
      allow create: if isRegistrationOfficer();
      allow update: if canVerify();
      allow delete: if false;
    }

    // --- Active Serial Numbers (Enforces 1:1 computer uniqueness) ---
    match /active_serials/{serialNumber} {
      allow read: if isRegistrationOfficer();
      allow create: if isRegistrationOfficer() && !exists(/databases/$(database)/documents/active_serials/$(serialNumber));
      allow update: if isAdmin();
      allow delete: if false;
    }


    // --- Verification Logs (Strictly Immutable Audit Trail) ---
    match /verification_logs/{logId} {
      allow read: if canVerify();
      allow create: if canVerify() && request.resource.data.verifiedBy == request.auth.uid;
      // Logs are strictly immutable once written - modifications and deletions are forbidden
      allow update, delete: if false;
    }
  }
}
